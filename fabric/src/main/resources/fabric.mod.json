    "main": [
      "es.rudahee.headmate.fabric.HeadMateFabric"
    ],
    "client": [
      "es.rudahee.headmate.fabric.HeadMateFabricClient"
    ]
  },
  "mixins": [
    "headmate.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "fabric-resource-loader-v0": "*",
    "fabric-networking-api-v1": "*",
    "java": ">=21"
  }
